# Zorecho / EchoAI — environment variable template (names only, no secrets)
# Copy to .env and fill in. Blank/fake values only in this template.
# Classification: see ENVIRONMENT_AND_INTEGRATIONS.md.

# ---- CRITICAL (server will not start without these) ----
DATABASE_URL=
JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=

# ---- Platform / runtime ----
NODE_ENV=development
APP_ENV=
PORT=
APP_URL=
PUBLIC_BASE_URL=
ALLOWED_ORIGINS=
RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=
JWT_EXPIRES_IN=
JWT_SESSION_EXPIRES_IN=
MAX_AUDIO_UPLOAD_BYTES=
MAX_DOC_UPLOAD_BYTES=
FREE_TEST_MODE=

# ---- Seed admin (sensitive) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Discrete DB config (fallback to DATABASE_URL) ----
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- AI providers ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
OPENAI_STT_MODEL=

# ---- Hermes / Nous decision brain ----
NOUS_PORTAL_API_KEY=
NOUS_PORTAL_BASE_URL=
NOUS_HERMES_MODEL=
HERMES_TIMEOUT_MS=
HERMES_ORCHESTRATOR_TIMEOUT_MS=
HERMES_MAX_ATTEMPTS=
ENABLE_CONVERSATIONAL_CORE=

# ---- AI cost controls ----
AI_ENABLED=
DEVELOPMENT_AI_ENABLED=
AI_BUDGET_GLOBAL_DAILY_USD=
AI_BUDGET_BACKGROUND_DAILY_USD=
AI_MAX_CALLS_PER_MINUTE=
AI_MAX_ATTEMPTS=
AI_TIMEOUT_MS=
AI_HEAVY_TIMEOUT_MS=
ECHO_DEFAULT_DAILY_BUDGET=
TARGET_COST_PER_LEAD=

# ---- Voice (ElevenLabs) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_API_BASE=
ELEVENLABS_MODEL_ID=
ELEVENLABS_OUTPUT_FORMAT=
ELEVENLABS_LANGUAGE_CODE=

# ---- Billing (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_SEAT=

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_MAX_RETRIES=

# ---- Facebook (OAuth) ----
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
FACEBOOK_GRAPH_VERSION=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_LINK_URL=

# ---- Google (OAuth) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=

# ---- Jobber (OAuth) ----
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=
JOBBER_API_VERSION=

# ---- Push notifications ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
FCM_SERVER_KEY=

# ---- Telephony / SMS (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SKIP_VALIDATION=
SALES_TWILIO_ACCOUNT_SID=
SALES_TWILIO_AUTH_TOKEN=
SALES_TWILIO_NUMBER=

# ---- Music ----
YOUTUBE_API_KEY=

# ---- Sage V2 feature flags (default OFF) ----
SAGE_V2_CONTEXT=
SAGE_V2_WEEKLY_BRIEFING=
SAGE_V2_OFFERS=
SAGE_V2_EXEC_MEMORY=
SAGE_V2_INTEL_STORE=
SAGE_V2_JOB_QUEUE=
SAGE_V2_SKIP_GATES=
SAGE_V2_DQ_SENTRY=
SAGE_V2_OPPORTUNITIES=
SAGE_V2_DIRECTIVES=
SAGE_V2_SCORECARDS=

# ---- Client build (Vite) ----
VITE_API_BASE_URL=
VITE_STRIPE_PUBLISHABLE_KEY=
BASE_URL=

# ---- Injected by host (do NOT set manually) ----
# RAILWAY_ENVIRONMENT / RAILWAY_ENVIRONMENT_NAME / RAILWAY_PROJECT_ID
# RAILWAY_GIT_COMMIT_SHA / RAILWAY_DEPLOYMENT_ID
# REPL_ID / REPLIT_DEV_DOMAIN / REPLIT_DOMAINS
</content>
